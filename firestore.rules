rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Share Resolution Helpers ---
    function getShare(token) {
      return get(/databases/$(database)/documents/shareConfigs/$(token)).data;
    }
    
    function isValidShare(token, entityId, entityType) {
      return exists(/databases/$(database)/documents/shareConfigs/$(token)) &&
             getShare(token).isActive == true && 
             getShare(token).entityId == entityId && 
             getShare(token).entityType == entityType &&
             (getShare(token).expiresAt == null || getShare(token).expiresAt > request.time);
    }

    function hasAccess(token, entityId, entityType, requiredPermission) {
      return isValidShare(token, entityId, entityType) && 
             (requiredPermission == 'view' || getShare(token).permission == 'edit') &&
             (getShare(token).visibility == 'public' || (isSignedIn() && request.auth.token.email in getShare(token).invitedEmails));
    }

    // --- Users ---
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // --- ShareConfigs ---
    match /shareConfigs/{token} {
      allow get: if isValidId(token);
      allow create: if isVerified() && isOwner(incoming().createdBy);
      allow update: if isVerified() && isOwner(existing().createdBy) && 
                       incoming().createdBy == existing().createdBy &&
                       incoming().token == existing().token;
      allow delete: if isVerified() && isOwner(existing().createdBy);
    }

    // --- Projects ---
    match /projects/{projectId} {
      allow get: if isOwner(resource.data.userId) || 
                    (request.params.get('token', null) != null && hasAccess(request.params.token, projectId, 'project', 'view'));
      allow list: if isOwner(resource.data.userId);
      allow create: if isVerified() && isOwner(incoming().userId);
      allow update: if isOwner(existing().userId) || 
                       (request.params.get('token', null) != null && hasAccess(request.params.token, projectId, 'project', 'edit'));
      allow delete: if isOwner(existing().userId);
    }

    // --- Checklists ---
    match /checklists/{checklistId} {
      function canAccessChecklist(requiredPerm) {
        return isOwner(existing().userId) ||
               (request.params.get('token', null) != null && hasAccess(request.params.token, checklistId, 'checklist', requiredPerm)) ||
               (existing().get('projectId', null) != null && request.params.get('token', null) != null && hasAccess(request.params.token, existing().projectId, 'project', requiredPerm));
      }

      allow get: if canAccessChecklist('view');
      allow list: if isOwner(resource.data.userId) || 
                    (resource.data.get('projectId', null) != null && request.params.get('token', null) != null && hasAccess(request.params.token, resource.data.projectId, 'project', 'view'));
      
      allow create: if isVerified() && isOwner(incoming().userId);
      allow update: if canAccessChecklist('edit');
      allow delete: if isOwner(existing().userId);

      // --- Items ---
      match /items/{itemId} {
        allow read: if canAccessChecklist('view');
        allow create, update, delete: if canAccessChecklist('edit');

        match /comments/{commentId} {
          allow read: if canAccessChecklist('view');
          allow create: if canAccessChecklist('view') && isSignedIn();
          allow update, delete: if isOwner(existing().userId);
        }
      }
    }

    // --- Todos ---
    match /todos/{todoId} {
      function canAccessTodo(requiredPerm) {
        return isOwner(existing().userId) ||
               (request.params.get('token', null) != null && hasAccess(request.params.token, todoId, 'todo', requiredPerm)) ||
               (existing().get('projectId', null) != null && request.params.get('token', null) != null && hasAccess(request.params.token, existing().projectId, 'project', requiredPerm));
      }

      allow get: if canAccessTodo('view');
      allow list: if isOwner(resource.data.userId) || 
                    (resource.data.get('projectId', null) != null && request.params.get('token', null) != null && hasAccess(request.params.token, resource.data.projectId, 'project', 'view'));
      allow create: if isVerified() && isOwner(incoming().userId);
      allow update: if canAccessTodo('edit');
      allow delete: if isOwner(existing().userId);
    }

    // --- GuestSessions ---
    match /guestSessions/{sessionId} {
      allow get: if true; // Public for verification
      allow create: if false; // Only via Admin/Server
      allow update, delete: if false;
    }
  }
}
