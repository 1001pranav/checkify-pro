rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // --- Share Resolution Helpers ---
    function getShare(token) {
      return get(/databases/$(database)/documents/shareConfigs/$(token)).data;
    }
    
    function isValidShare(token, entityId, entityType) {
      return exists(/databases/$(database)/documents/shareConfigs/$(token)) &&
             getShare(token).isActive == true && 
             getShare(token).entityId == entityId && 
             getShare(token).entityType == entityType &&
             (getShare(token).expiresAt == null || getShare(token).expiresAt > request.time);
    }

    function hasAccess(token, entityId, entityType, requiredPermission) {
      return isValidShare(token, entityId, entityType) && 
             (requiredPermission == 'view' || getShare(token).permission == 'edit') &&
             (getShare(token).visibility == 'public' || (isSignedIn() && request.auth.token.email in getShare(token).invitedEmails));
    }

    function isPubliclyShared(data, entityId, entityType) {
      return data.get('shareToken', null) != null && 
             isValidShare(data.shareToken, entityId, entityType) &&
             getShare(data.shareToken).visibility == 'public';
    }

    // --- Users ---
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // --- ShareConfigs ---
    match /shareConfigs/{token} {
      allow get: if isValidId(token);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isOwner(incoming().createdBy);
      allow update: if isSignedIn() && isOwner(existing().createdBy) && 
                       incoming().createdBy == existing().createdBy;
      allow delete: if isSignedIn() && isOwner(existing().createdBy);
    }

    // --- Projects ---
    match /projects/{projectId} {
      allow get: if isOwner(resource.data.userId) || isPubliclyShared(resource.data, projectId, 'project');
      allow list: if isOwner(resource.data.userId) || isPubliclyShared(resource.data, projectId, 'project');
      allow create: if isVerified() && isOwner(incoming().userId);
      allow update: if isOwner(existing().userId);
      allow delete: if isOwner(existing().userId);
    }

    // --- Checklists ---
    match /checklists/{checklistId} {
      function canAccessChecklist(data, requiredPerm) {
        return isOwner(data.userId) ||
               (data.get('shareToken', null) != null && hasAccess(data.shareToken, checklistId, 'checklist', requiredPerm)) ||
               (data.get('projectId', null) != null && 
                get(/databases/$(database)/documents/projects/$(data.projectId)).data.get('shareToken', null) != null &&
                hasAccess(get(/databases/$(database)/documents/projects/$(data.projectId)).data.shareToken, data.projectId, 'project', requiredPerm));
      }

      allow get: if canAccessChecklist(resource.data, 'view');
      allow list: if canAccessChecklist(resource.data, 'view');
      
      allow create: if (isVerified() && isOwner(incoming().userId)) || 
                       canAccessChecklist(incoming(), 'edit');
      allow update: if canAccessChecklist(resource.data, 'edit');
      allow delete: if isOwner(resource.data.userId);

      // --- Items ---
      match /items/{itemId} {
        // Items inherit from their parent checklist
        function getChecklist() {
          return exists(/databases/$(database)/documents/checklists/$(checklistId))
            ? get(/databases/$(database)/documents/checklists/$(checklistId)).data
            : null;
        }

        allow read: if getChecklist() != null && canAccessChecklist(getChecklist(), 'view');
        allow create, update: if getChecklist() != null && canAccessChecklist(getChecklist(), 'edit');
        allow delete: if getChecklist() == null || canAccessChecklist(getChecklist(), 'edit');

        match /comments/{commentId} {
          allow read: if getChecklist() != null && canAccessChecklist(getChecklist(), 'view');
          allow create: if getChecklist() != null && canAccessChecklist(getChecklist(), 'view') && (isSignedIn() || getChecklist().get('projectId', null) != null);
          allow update: if isOwner(resource.data.userId);
          allow delete: if getChecklist() == null || isOwner(resource.data.userId) || isOwner(getChecklist().userId);
        }
      }
    }

    // --- Todos ---
    match /todos/{todoId} {
      function canAccessTodo(data, requiredPerm) {
        return isOwner(data.userId) ||
               (data.get('shareToken', null) != null && hasAccess(data.shareToken, todoId, 'todo', requiredPerm)) ||
               (data.get('projectId', null) != null && 
                get(/databases/$(database)/documents/projects/$(data.projectId)).data.get('shareToken', null) != null &&
                hasAccess(get(/databases/$(database)/documents/projects/$(data.projectId)).data.shareToken, data.projectId, 'project', requiredPerm));
      }

      allow get: if canAccessTodo(resource.data, 'view');
      allow list: if canAccessTodo(resource.data, 'view');
      allow create: if (isVerified() && isOwner(incoming().userId)) ||
                       canAccessTodo(incoming(), 'edit');
      allow update: if canAccessTodo(resource.data, 'edit');
      allow delete: if isOwner(resource.data.userId);
    }

    // --- GuestSessions ---
    match /guestSessions/{sessionId} {
      allow get: if true; // Public for verification
      allow create: if false; // Only via Admin/Server
      allow update, delete: if false;
    }
  }
}
