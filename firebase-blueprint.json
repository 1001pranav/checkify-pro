{
  "entities": {
    "Checklist": {
      "title": "Checklist",
      "description": "A checklist container for items.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner's UID" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed", "archived"] },
        "completedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "status", "createdAt", "updatedAt"]
    },
    "ChecklistItem": {
      "title": "Checklist Item",
      "description": "An individual item in a checklist.",
      "type": "object",
      "properties": {
        "checklistId": { "type": "string" },
        "text": { "type": "string" },
        "description": { "type": "string" },
        "outcome": { "type": "string", "description": "Status of the ritual step" },
        "isDone": { "type": "boolean" },
        "photoUrl": { "type": "string" },
        "photoUrls": { "type": "array", "items": { "type": "string" }, "description": "Multiple verification photos" },
        "position": { "type": "number" },
        "parentId": { "type": "string", "description": "ID of parent item for nesting" },
        "shareToken": { "type": "string", "description": "Optional token for shared editing" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["checklistId", "text", "isDone", "position", "createdAt"]
    },
    "ShareConfig": {
      "title": "Share Configuration",
      "description": "Configuration for sharing an entity.",
      "type": "object",
      "properties": {
        "entityType": { "type": "string", "enum": ["checklist", "todo", "project"] },
        "entityId": { "type": "string" },
        "token": { "type": "string" },
        "visibility": { "type": "string", "enum": ["public", "private"] },
        "permission": { "type": "string", "enum": ["view", "edit"] },
        "invitedEmails": { "type": "array", "items": { "type": "string" } },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "isActive": { "type": "boolean" }
      },
      "required": ["entityType", "entityId", "token", "visibility", "permission", "createdBy", "createdAt", "isActive"]
    },
    "GuestSession": {
      "title": "Guest Session",
      "description": "Session for unregistered users to access private shares.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "shareToken": { "type": "string" },
        "magicToken": { "type": "string" },
        "sessionToken": { "type": "string" },
        "expiresAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "shareToken", "magicToken", "sessionToken", "expiresAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "User projects"
    },
    "/checklists/{checklistId}": {
      "schema": "Checklist",
      "description": "Root checklists collection"
    },
    "/checklists/{checklistId}/items/{itemId}": {
      "schema": "ChecklistItem",
      "description": "Subcollection of items for a checklist"
    },
    "/checklists/{checklistId}/items/{itemId}/comments/{commentId}": {
      "schema": "ItemComment",
      "description": "Subcollection of comments for a checklist item"
    },
    "/shareConfigs/{token}": {
      "schema": "ShareConfig",
      "description": "Unified sharing configurations"
    },
    "/guestSessions/{sessionId}": {
      "schema": "GuestSession",
      "description": "Guest access sessions"
    },
    "/todos/{todoId}": {
      "schema": "Todo",
      "description": "Users individual todos list"
    }
  }
}
