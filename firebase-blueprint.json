{
  "entities": {
    "Checklist": {
      "title": "Checklist",
      "description": "A checklist container for items.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Owner's UID" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed", "archived"] },
        "completedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "status", "createdAt", "updatedAt"]
    },
    "ChecklistItem": {
      "title": "Checklist Item",
      "description": "An individual item in a checklist.",
      "type": "object",
      "properties": {
        "checklistId": { "type": "string" },
        "text": { "type": "string" },
        "isDone": { "type": "boolean" },
        "photoUrl": { "type": "string" },
        "photoUrls": { "type": "array", "items": { "type": "string" }, "description": "Multiple verification photos" },
        "position": { "type": "number" },
        "parentId": { "type": "string", "description": "ID of parent item for nesting" },
        "shareToken": { "type": "string", "description": "Optional token for shared editing" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["checklistId", "text", "isDone", "position", "createdAt"]
    },
    "ChecklistShare": {
      "title": "Checklist Share",
      "description": "Public share configuration for a checklist.",
      "type": "object",
      "properties": {
        "checklistId": { "type": "string" },
        "userId": { "type": "string" },
        "token": { "type": "string" },
        "permission": { "type": "string", "enum": ["view", "edit"] },
        "revoked": { "type": "boolean" },
        "isPublic": { "type": "boolean" },
        "sharedByName": { "type": "string" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["checklistId", "userId", "token", "permission", "isPublic", "createdAt"]
    },
    "Todo": {
      "title": "Todo",
      "description": "A standalone todo item.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "note": { "type": "string" },
        "isDone": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "isDone", "createdAt", "updatedAt"]
    },
    "ItemComment": {
      "title": "Item Comment",
      "description": "A comment on a checklist item.",
      "type": "object",
      "properties": {
        "itemId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["itemId", "userId", "userName", "text", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "A container for grouped checklists and todos.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "shareToken": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "createdAt", "updatedAt"]
    },
    "ProjectShare": {
      "title": "Project Share",
      "description": "Public share configuration for a project.",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "userId": { "type": "string" },
        "token": { "type": "string" },
        "permission": { "type": "string", "enum": ["view", "edit"] },
        "revoked": { "type": "boolean" },
        "isPublic": { "type": "boolean" },
        "sharedByName": { "type": "string" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["projectId", "userId", "token", "permission", "isPublic", "createdAt"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "User projects"
    },
    "/projectShares/{shareToken}": {
      "schema": "ProjectShare",
      "description": "Project share tokens"
    },
    "/checklists/{checklistId}": {
      "schema": "Checklist",
      "description": "Root checklists collection"
    },
    "/checklists/{checklistId}/items/{itemId}": {
      "schema": "ChecklistItem",
      "description": "Subcollection of items for a checklist"
    },
    "/checklists/{checklistId}/items/{itemId}/comments/{commentId}": {
      "schema": "ItemComment",
      "description": "Subcollection of comments for a checklist item"
    },
    "/shares/{shareToken}": {
      "schema": "ChecklistShare",
      "description": "Public share tokens"
    },
    "/todos/{todoId}": {
      "schema": "Todo",
      "description": "Users individual todos list"
    }
  }
}
