rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Blanket read access for viewing audit results
    match /{allPaths=**} {
      allow read: if true;
    }

    // Checklist photos: Secure by requiring auth and enforcing path-based ownership
    match /checklist-photos/{checklistId}/{userId}/{itemId}/{photoId} {
      allow create: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      
      allow read: if true;

      // Only the original uploader (or the same authenticated identity) can delete/update
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
