rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Blanket read access for viewing audit results
    match /{allPaths=**} {
      allow read: if true;
    }

    // Checklist photos: Allow creation for anyone if it's a valid image (supports guest audits)
    // Identity is tracked via custom metadata in the app
    match /checklist-photos/{allPaths=**} {
      allow create: if request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      
      // Allow read for everyone
      allow read: if true;

      // Allow update and delete for any authenticated user (logged in or anonymous)
      allow update, delete: if request.auth != null;
    }
  }
}
